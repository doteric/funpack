{
  "name": "funpack",
  "version": "0.0.0-dev",
  "description": "Function Packager",
  "main": "dist/index.js",
  "files": [
    "dist/*"
  ],
  "bin": {
    "funpack": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "precompile": "rimraf ./dist",
    "compile": "tsc",
    "test": "npm run jest --coverage && npm run lint && npm run prettier",
    "fix": "npm run lint --fix && npm run prettier-fix",
    "jest": "jest",
    "lint": "eslint ./src",
    "prettier": "prettier --check ./src",
    "prettier-fix": "prettier --write ./src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doteric/funpack.git"
  },
  "keywords": [
    "funpack",
    "Function",
    "Lambda",
    "Packager"
  ],
  "author": "doteric",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^7.0.0",
    "@types/jest": "^30.0.0",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "prettier": "^2.6.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "commander": "^9.3.0",
    "esbuild": "^0.28.2",
    "resolve-package-path": "^4.0.3",
    "zod": "^4.6.7"
  }
}
